# Laboratory-only values. Copy to .env and replace before any non-lab use.
POSTGRES_DB=locker_lab
POSTGRES_USER=locker
POSTGRES_PASSWORD=locker_lab_only_change_me
RUST_DATABASE_URL=postgresql://locker:locker_lab_only_change_me@postgres:5432/locker_lab
MQTT_HOST=mosquitto
MQTT_PORT=1883
LOCKER_ID=LAB-LOCKER-001
APP_ENV=lab
LOG_LEVEL=INFO
TIMEZONE=America/Asuncion
# Rust laboratory backend (primary service since Fase 4.3/4.4).
RUST_DB_MAX_CONNECTIONS=5
RUST_DB_TIMEOUT_SECONDS=3
RUST_LOG=info
# Rust MQTT bridge: QoS 1 with atomic claim, recovery and TTL.
RUST_MQTT_ENABLED=true
RUST_MQTT_HOST=mosquitto
RUST_MQTT_PORT=1883
RUST_MQTT_CLIENT_ID=locker-api-rust
RUST_MQTT_CONFIRM_TIMEOUT_SECONDS=60
RUST_PRESENCE_STALE_SECONDS=90
